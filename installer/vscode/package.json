{
  "name": "k-playbook-workspace-tools",
  "displayName": "k-playbook Workspace Tools",
  "description": "Workspace-Aktionen von k-playbook — Kephalaion-Collections im Arbeitsbereich",
  "version": "0.3.0",
  "publisher": "kascada",
  "repository": "https://github.com/kascada/k-playbook",
  "engines": { "vscode": "^1.101.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "kPlaybook.initWorkspace",
        "title": "Kephalaion-Collections einbinden",
        "category": "k-playbook"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kPlaybook.initWorkspace",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  }
}
