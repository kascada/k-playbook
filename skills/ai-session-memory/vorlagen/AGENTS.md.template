├── opencode.json                      OpenCode-Konfig (bindet AGENTS.md ein)
├── <verzeichnisse/repos>
└── k-playbook-local/
    ├── docs/                          ★ die autoritative Dokumentation
    │   ├── README.md                  Index über alle Herkünfte
    │   ├── code/  libs/  extracted/  manual/
    └── material/                      Rohmaterial, nie indiziert
```

