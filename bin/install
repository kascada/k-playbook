#!/usr/bin/env bash
set -euo pipefail

# Installiert k-playbook nach ~/.local/bin: das Release-Binary des neuesten
# Release-Tags, geprüft gegen die SHA256SUMS dieses Tags. Danach Kephalaion,
# wenn es auf diesem Rechner fehlt.
#
# Das Skript ist eigenständig — es liest nichts neben sich:
#
#   curl -fsSL https://raw.githubusercontent.com/kascada/k-playbook/main/bin/install | bash
#
# Aus einem Clone aufgerufen (make -C k-playbook install, k-playbook/bin/install)
# verhält es sich genauso: Es liest weder VERSION noch SHA256SUMS des Clones
# und installiert den neuesten Tag, nicht den Stand des Clones.
#
# Tag und Prüfsumme bestimmt es wie das Programm selbst (installer/internal/
# release): der Tag ist der des neuesten veröffentlichten Release, gelesen aus
# der Weiterleitung von <repo>/releases/latest auf <repo>/releases/tag/<tag>,
# ohne ihr zu folgen — über HTTPS, anonym, ohne die GitHub-API. Die erwartete
# Summe kommt aus der committeten SHA256SUMS des Tags
# (raw.githubusercontent.com), das Binary aus den Assets des Releases. Summe
# über den Git-Stand, Binary über das Release: ein ausgetauschtes Asset fällt
# auf. Gebraucht werden curl oder wget und sha256sum oder shasum; git nicht.
#
# Die CI veröffentlicht ein Release erst mit allen Assets; ein Tag, dessen
# Assets noch gebaut werden, ist unter releases/latest nicht zu sehen. Fehlt
# ein Asset trotzdem, sagt das Skript, dass das Release nicht fertig ist, und
# ersetzt nichts.
#
# Der ganze Ablauf steht in main und wird erst in der letzten Zeile gerufen:
# Über `curl | bash` liest bash das Skript von stdin. So ist es vollständig
# gelesen, bevor etwas läuft — ein abgebrochener Download führt nichts aus —,
# und kein Kindprozess kann den Rest des Skripts von stdin wegfressen.

latest_url="https://github.com/kascada/k-playbook/releases/latest"
tag_prefix="https://github.com/kascada/k-playbook/releases/tag/"
raw_base_url="https://raw.githubusercontent.com/kascada/k-playbook"
release_base_url="https://github.com/kascada/k-playbook/releases/download"
install_script_url="https://raw.githubusercontent.com/kascada/k-playbook/main/bin/install"
kephalaion_install_url="https://github.com/kephalaion/kephalaion/releases/latest/download/install.sh"

# K_PLAYBOOK_RELEASE_SOURCE ersetzt die Quelle oder schaltet sie ab — dieselbe
# Variable mit derselben Bedeutung wie im Programm (release.EnvSource), die
# Naht für Tests: leer ist GitHub, "off" heißt kein Abruf, sonst eine
# Basis-URL mit <basis>/releases/latest (Weiterleitung auf
# <basis>/releases/tag/<tag>), <basis>/raw/<tag>/SHA256SUMS,
# <basis>/download/<tag>/<asset> und <basis>/kephalaion/install.sh.
source_note=""
case "${K_PLAYBOOK_RELEASE_SOURCE:-}" in
  "") ;;
  off) source_note="off" ;;
  *)
    source_base="${K_PLAYBOOK_RELEASE_SOURCE%/}"
    latest_url="${source_base}/releases/latest"
    tag_prefix="${source_base}/releases/tag/"
    raw_base_url="${source_base}/raw"
    release_base_url="${source_base}/download"
    kephalaion_install_url="${source_base}/kephalaion/install.sh"
    source_note="${source_base}"
    ;;
esac

install_command="curl -fsSL ${install_script_url} | bash"

fail() {
  printf '%s\n' "$@" >&2
  exit 1
}

usage() {
  cat <<EOF
Verwendung: ${install_command}
   aus einem Clone: make -C k-playbook install
         ohne make: k-playbook/bin/install

Bestimmt das neueste Release von k-playbook (die Weiterleitung von
releases/latest auf GitHub), lädt das Release-Binary dieser Plattform, prüft es gegen die SHA256SUMS des
Tags und installiert es nach ~/.local/bin/k-playbook. Fehlt Kephalaion auf
diesem Rechner, installiert es danach über das install.sh des neuesten
Kephalaion-Releases.

Aus einem Clone aufgerufen verhält es sich gleich: VERSION und SHA256SUMS des
Clones liest es nicht. Gebraucht werden curl oder wget und sha256sum oder
shasum.
EOF
}

# physical_path löst Symlinks im Pfad auf, soweit das Verzeichnis existiert.
# Auf macOS ist $HOME über /System/Volumes/Data verlinkt; ohne die Auflösung
# hielte der PATH-Vergleich zwei Schreibweisen desselben Verzeichnisses
# auseinander.
physical_path() {
  local dir="$1"
  [[ -d "${dir}" ]] || { printf '%s' "${dir}"; return 0; }
  (cd -P "${dir}" 2>/dev/null && pwd) || printf '%s' "${dir}"
}

# path_contains meldet, ob ein Verzeichnis im PATH steht — verglichen wird die
# Schreibweise selbst und, wo auflösbar, der physische Pfad.
path_contains() {
  local wanted="$1" wanted_physical entry
  local -a entries=()
  wanted_physical="$(physical_path "${wanted}")"
  # Zerlegt wird über `read -a` und nicht über ein ungequotetes ${PATH}: dort
  # greift neben dem Wortsplitting auch die Pfadnamen-Expansion. Ein Eintrag
  # mit *, ? oder [ würde dann durch passende Dateinamen ersetzt — und ein
  # Verzeichnis, das tatsächlich im PATH steht, gälte als nicht gefunden.
  IFS=":" read -r -a entries <<<"${PATH}"
  [[ ${#entries[@]} -gt 0 ]] || return 1
  for entry in "${entries[@]}"; do
    [[ -n "${entry}" ]] || continue
    if [[ "${entry}" == "${wanted}" || "${entry}" == "${wanted_physical}" ]]; then
      return 0
    fi
    if [[ -d "${entry}" && "$(physical_path "${entry}")" == "${wanted_physical}" ]]; then
      return 0
    fi
  done
  return 1
}

# require_target_dir_in_path bricht ab, wenn das Zielverzeichnis nicht im PATH
# liegt.
#
# Das ist kein Hinweis am Rand: `k-playbook` ist der einzige Aufruf. Ein
# installiertes, aber nicht auffindbares Binary wäre ein stiller Totalausfall —
# Commands, Instruktionen und die MCP-Registrierung liefen alle ins Leere, ohne
# dass die Installation je etwas gemeldet hätte.
# Geprüft wird erst, nachdem das Zielverzeichnis angelegt ist: sonst bewertet
# die Prüfung eine Lage, die die Installation selbst gerade aufgelöst hat.
# Welcher Hinweis richtig ist, hängt genau daran — deshalb der Blick auf
# target_dir_created.
require_target_dir_in_path() {
  if path_contains "${target_dir}"; then
    return 0
  fi

  local -a hint
  if [[ -n "${target_dir_created}" ]]; then
    # Der Debian-Fall: dort steht die Aufnahme von ~/.local/bin bereits in
    # ~/.profile, aber unter `if [ -d "$HOME/.local/bin" ]`. Bei der
    # allerersten Installation auf einem frischen Host oder in einem
    # DevContainer gab es das Verzeichnis beim Anmelden noch nicht — das Profil
    # ist also richtig und greift ab der nächsten Anmeldung von selbst.
    hint=(
      "Das Verzeichnis gab es bis eben nicht; angelegt ist es jetzt. Debian und"
      "Ubuntu nehmen ~/.local/bin in ~/.profile nur auf, wenn es beim Anmelden"
      "bereits existiert — dort ist nichts zu ändern. Melde dich neu an oder"
      "lade dein Profil neu (bash: . ~/.profile) und rufe die Installation"
      "erneut auf:"
      ""
      "  ${install_command}"
      ""
      "Bleibt das Verzeichnis auch danach draußen, kennt dein Profil den Eintrag"
      "nicht. Dann aufnehmen — ~/.zprofile bei zsh, ~/.bashrc bei bash:"
      ""
      '  export PATH="$HOME/.local/bin:$PATH"'
    )
  else
    hint=(
      "Ins Shell-Profil aufnehmen — ~/.zprofile bei zsh, ~/.bashrc bei bash:"
      ""
      '  export PATH="$HOME/.local/bin:$PATH"'
      ""
      "Danach eine neue Shell öffnen und die Installation erneut aufrufen."
    )
  fi

  fail "${target_dir} liegt nicht im PATH." \
    "" \
    "k-playbook wird ausschließlich unter seinem Namen aufgerufen; ohne diesen" \
    "Eintrag wäre es zwar installiert, aber nirgends auffindbar. Deshalb bricht" \
    "die Installation hier ab, statt einen stillen Erfolg zu melden." \
    "" \
    "${hint[@]}"
}

# foreign_platform_kind meldet, welcher fremden Plattform ein bereits
# vorhandenes Binary angehört: "macOS", "Linux" oder leer.
#
# Erkannt wird an den Magic-Bytes, nicht über `file` — das fehlt in schlanken
# Containern. Gemeldet wird nur, was sich positiv als Format der jeweils
# anderen Plattform lesen lässt; alles andere (Skript, Symlink, Fragment)
# bleibt stumm.
foreign_platform_kind() {
  local path="$1" magic
  [[ -f "${path}" && ! -L "${path}" ]] || return 0
  magic="$(head -c 4 "${path}" 2>/dev/null | od -An -v -tx1 | tr -d ' \n')"
  case "${os}:${magic}" in
    # ELF auf einem Darwin-Host.
    darwin:7f454c46) printf 'Linux' ;;
    # Mach-O (32/64 Bit, beide Endianness) und Universal Binaries auf Linux.
    linux:cffaedfe|linux:cefaedfe|linux:feedface|linux:feedfacf|linux:cafebabe|linux:bebafeca) printf 'macOS' ;;
    *) : ;;
  esac
}

# latest_tag nennt den Tag des neuesten veröffentlichten Release: das Ziel der
# Weiterleitung von releases/latest, ohne ihr zu folgen. Ein Tag mit Zusatz
# (v1.0.0-rc.1) ist kein Release, auch wenn er als neuestes markiert wäre.
#
# Rückgabe 1 mit dem Grund auf stderr, wenn sich kein solcher Tag bestimmen
# ließ — ohne Netz, ohne veröffentlichtes Release, ohne Weiterleitung.
latest_tag() {
  local answer code target tag
  if ! answer="$(redirect_of "${latest_url}")" || [[ -z "${answer}" ]]; then
    printf 'Keine Antwort von %s.\n' "${latest_url}" >&2
    return 1
  fi
  code="${answer%% *}"
  target=""
  [[ "${answer}" != *" "* ]] || target="${answer#* }"
  case "${code}" in
    301|302|303|307|308) ;;
    404)
      printf '%s antwortet mit 404: es gibt kein veröffentlichtes Release.\n' "${latest_url}" >&2
      return 1
      ;;
    *)
      printf '%s antwortet mit %s statt mit einer Weiterleitung auf das neueste Release.\n' "${latest_url}" "${code}" >&2
      return 1
      ;;
  esac
  tag="${target#"${tag_prefix}"}"
  if [[ -z "${target}" || "${tag}" == "${target}" || -z "${tag}" || "${tag}" == */* ]]; then
    printf '%s leitet nicht auf ein Release weiter, sondern auf %s.\n' "${latest_url}" "${target:-nichts}" >&2
    return 1
  fi
  if [[ ! "${tag}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'Das neueste Release trägt den Tag %s, keinen der Form vX.Y.Z.\n' "${tag}" >&2
    return 1
  fi
  printf '%s\n' "${tag}"
}

# install_kephalaion installiert Kephalaion, wenn es im PATH fehlt — über das
# install.sh aus dem neuesten Kephalaion-Release: Asset-Namen, Plattformen und
# Prüfsumme bleiben damit Sache von Kephalaion. Ein vorhandenes Kephalaion
# bleibt unangetastet, herabgestuft wird nie; aktualisiert wird über
# `k-playbook upgrade`, das `kephalaion upgrade --auto` aufruft.
#
# node init, service install und Token ruft dieses Skript nicht auf: Im
# DevContainer kommt die config read-only vom Host, und der Node ist der des
# Hosts. Das install.sh von Kephalaion tut aber mehr als das Binary abzulegen:
# Es ruft danach `kephalaion node mcp add --auto` auf und, wenn ein Editor-CLI
# im PATH liegt, `kephalaion vscode install --code` — es meldet den Node also
# bei den Assistenten an und installiert die Erweiterung.
install_kephalaion() {
  local found work
  if found="$(command -v kephalaion 2>/dev/null)"; then
    printf 'Kephalaion vorhanden: %s\n' "${found}"
    return 0
  fi

  work="$(mktemp -d)"
  # Erst ganz laden, dann ausführen: Bricht der Download ab, läuft kein halbes
  # Skript, und ein Fehler beim Laden ist von einem Fehler der Installation zu
  # unterscheiden.
  printf 'Kephalaion fehlt; lade %s ...\n' "${kephalaion_install_url}"
  if ! download_quiet "${work}/install.sh" "${kephalaion_install_url}"; then
    rm -rf "${work}"
    printf 'install.sh von Kephalaion nicht ladbar: %s\n' "${kephalaion_install_url}" >&2
    return 1
  fi
  local status=0
  sh "${work}/install.sh" </dev/null || status=$?
  rm -rf "${work}"
  return "${status}"
}

main() {
  case "${1:-}" in
    "") ;;
    help|-h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac

  if [[ "${source_note}" == "off" ]]; then
    fail "Die Release-Abfrage ist abgeschaltet (K_PLAYBOOK_RELEASE_SOURCE=off); installiert wird nichts."
  fi
  if [[ -n "${source_note}" ]]; then
    printf 'Release-Quelle ersetzt über K_PLAYBOOK_RELEASE_SOURCE: %s\n' "${source_note}"
  fi

  case "$(uname -s)" in
    Linux) os="linux" ;;
    Darwin) os="darwin" ;;
    *) fail "Nicht unterstütztes Betriebssystem: $(uname -s)" ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64) arch="amd64" ;;
    arm64|aarch64) arch="arm64" ;;
    *) fail "Nicht unterstützte Architektur: $(uname -m)" ;;
  esac

  binary="k-playbook-${os}-${arch}"

  if command -v sha256sum >/dev/null 2>&1; then
    sha256_of() { sha256sum "$1" | awk '{ print $1 }'; }
  elif command -v shasum >/dev/null 2>&1; then
    sha256_of() { shasum -a 256 "$1" | awk '{ print $1 }'; }
  else
    fail "Weder sha256sum noch shasum verfügbar; Download kann nicht geprüft werden."
  fi

  # Alle Downloads ohne stdin: Unter curl | bash ist stdin das Skript selbst.
  #
  # redirect_of fragt eine Adresse mit HEAD, folgt keiner Weiterleitung und
  # nennt "<status> <ziel>" — das Ziel absolut, leer ohne Weiterleitung.
  if command -v curl >/dev/null 2>&1; then
    download() { curl -fL --retry 2 --connect-timeout 15 --output "$1" "$2" </dev/null; }
    download_quiet() { curl -fsSL --retry 2 --connect-timeout 15 --output "$1" "$2" </dev/null; }
    redirect_of() {
      curl -sS -I -o /dev/null -w '%{http_code} %{redirect_url}' --connect-timeout 15 --max-time 30 "$1" </dev/null
    }
  elif command -v wget >/dev/null 2>&1; then
    download() { wget --output-document="$1" "$2" </dev/null; }
    download_quiet() { wget -q --output-document="$1" "$2" </dev/null; }
    # wget endet bei einer nicht gefolgten Weiterleitung mit 8; gelesen werden
    # deshalb nur die Kopfzeilen. Ein relatives Ziel bekommt Schema und Host
    # der gefragten Adresse.
    redirect_of() {
      local headers origin
      headers="$(wget -q -S --spider --max-redirect=0 --timeout=15 --tries=1 "$1" 2>&1 </dev/null)" || true
      origin="$(printf '%s' "$1" | sed -E 's#^([A-Za-z]+://[^/]+).*#\1#')"
      printf '%s\n' "${headers}" | awk -v origin="${origin}" '
        $1 ~ /^HTTP\// { code = $2 }
        tolower($1) == "location:" { location = $2; if (location ~ /^\//) location = origin location }
        END { if (code == "") exit 1; printf "%s %s", code, location }'
    }
  else
    fail "Weder curl noch wget verfügbar; Release-Binary kann nicht geladen werden."
  fi

  target_dir="${HOME:?HOME ist nicht gesetzt}/.local/bin"
  target="${target_dir}/k-playbook"

  # Das Zielverzeichnis entsteht **vor** der PATH-Prüfung. Debians und Ubuntus
  # ~/.profile nimmt ~/.local/bin nur auf, `if [ -d "$HOME/.local/bin" ]`; auf
  # einem frischen Host oder in einem DevContainer gibt es das Verzeichnis bei
  # der allerersten Installation noch nicht. Andersherum bewertete die Prüfung
  # eine Lage, die eine Zeile später ohnehin aufgelöst war, und verwies auf ein
  # Profil, das längst richtig ist.
  target_dir_created=""
  [[ -d "${target_dir}" ]] || target_dir_created="ja"
  mkdir -p "${target_dir}"

  # Beide Prüfungen laufen **vor** jedem Abruf: sie brauchen kein Netz, und
  # ein Abbruch soll nichts geladen und nichts ersetzt haben. Das angelegte
  # Zielverzeichnis bleibt dabei stehen — leer und genau dort, wo das Profil
  # bei der nächsten Anmeldung nachsieht.
  require_target_dir_in_path
  foreign="$(foreign_platform_kind "${target}")"

  version="$(latest_tag)" ||
    fail "Das neueste Release ließ sich nicht bestimmen (${latest_url})." \
      "Ohne Netz ist das zu erwarten; installiert wurde nichts."
  printf 'Neuestes Release: %s\n' "${version}"

  sums="$(mktemp)"
  temporary="$(mktemp "${target_dir}/.k-playbook.XXXXXX")"
  trap 'rm -f "${temporary}" "${sums}"' EXIT

  sums_url="${raw_base_url}/${version}/SHA256SUMS"
  download_quiet "${sums}" "${sums_url}" ||
    fail "SHA256SUMS von ${version} nicht ladbar: ${sums_url}"
  expected="$(awk -v name="${binary}" '$2 == name || $2 == "*" name { print $1; exit }' "${sums}")"
  [[ -n "${expected}" ]] || fail "Keine Prüfsumme für ${binary} in SHA256SUMS von ${version} (${sums_url})"

  url="${release_base_url}/${version}/${binary}"
  printf 'Lade %s ...\n' "${url}"
  download "${temporary}" "${url}" ||
    fail "Das Release-Binary ließ sich nicht laden: ${url}" \
      "Fehlt das Asset (404), ist das Release ${version} noch nicht fertig bestückt." \
      "Später erneut aufrufen. Ersetzt wurde nichts."

  actual="$(sha256_of "${temporary}")"
  if [[ "${actual}" != "${expected}" ]]; then
    fail "Prüfsumme weicht ab für ${binary}
  erwartet: ${expected}
  erhalten: ${actual}
Ersetzt wurde nichts."
  fi

  # Ein alter Symlink muss selbst ersetzt werden, nicht sein bisheriges Ziel.
  if [[ -L "${target}" ]]; then
    rm -f "${target}"
  fi
  chmod 0755 "${temporary}"
  mv -f "${temporary}" "${target}"
  temporary=""

  # Der alte Wrapper legte seine Spiegelung und Downloads außerhalb von bin/ ab:
  # die Spiegelung unter ~/.local/share/k-playbook/installation, die Binaries
  # unter ~/.cache/k-playbook/bin/<version>/. Security-Tool-venvs liegen
  # ebenfalls unter ~/.local/share/k-playbook und der Cache des neuesten
  # Release unter ~/.cache/k-playbook/latest-release.json; beide bleiben
  # ausdrücklich außerhalb dieser Bereinigung.
  rm -rf "${HOME}/.local/share/k-playbook/installation" "${HOME}/.cache/k-playbook/bin"

  printf 'Installiert: %s (%s, sha256 %s)\n' "${target}" "${version}" "${actual}"

  # Host und DevContainer, die sich dasselbe $HOME teilen, überschreiben
  # einander an dieser Datei. Das ist kein Fehler dieses Laufs — hier steht
  # jetzt das richtige Binary —, aber die andere Umgebung ist damit lahmgelegt
  # und muss dieselbe Installation noch einmal ausführen. Deshalb wird das
  # Ersetzen genannt und nicht stillschweigend getan. Genannt wird dieses
  # Skript, nicht `k-playbook upgrade`: Das Binary dort lässt sich nicht mehr
  # ausführen.
  #
  # Die Grenze dieser Erkennung: sie sitzt hier und in `k-playbook upgrade`
  # (release.Install). Ruft jemand ~/.local/bin/k-playbook direkt auf, während
  # dort ein plattformfremdes Binary liegt, fängt das niemand ab — der Aufruf
  # endet mit der Meldung der Shell ("cannot execute binary file").
  if [[ -n "${foreign}" ]]; then
    printf '\n'
    printf 'Ersetzt wurde ein %s-Binary — offenbar teilen sich Host und Container\n' "${foreign}"
    printf 'dasselbe HOME (%s).\n' "${HOME}"
    printf 'In der anderen Umgebung ist k-playbook damit bis auf Weiteres tot; dort\n'
    printf 'erneut installieren:\n\n'
    printf '  %s\n' "${install_command}"
  fi

  # Kephalaion gehört zu jedem Rechner, auf dem k-playbook läuft; fehlt es,
  # wird es hier nachgeholt. Scheitert das, endet dieser Lauf trotzdem mit 0:
  # k-playbook selbst ist installiert, und Binaries von vor Task 149 messen
  # den Erfolg ihres Programm-Updates an diesem Exit-Code. Ein Fehlschlag hier
  # meldete dort ein gescheitertes Programm-Update, das es nicht gab.
  # `k-playbook upgrade` holt Kephalaion in einem eigenen Schritt nach, und
  # k-playbook health nennt es, solange es fehlt.
  printf '\n'
  if ! install_kephalaion; then
    printf '\n' >&2
    printf 'Kephalaion ist nicht installiert (siehe oben); k-playbook selbst ist es.\n' >&2
    printf 'Nachholen: k-playbook upgrade\n' >&2
  fi
}

main "$@"
