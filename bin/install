#!/usr/bin/env bash
set -euo pipefail

# Installiert das passende Release-Binary dieses Clones in ~/.local/bin. Der
# Installer bleibt im Clone, damit VERSION und SHA256SUMS unabhängig vom
# heruntergeladenen Asset geprüft werden können.

release_base_url="https://github.com/kascada/k-playbook/releases/download"

fail() {
  printf '%s\n' "$@" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Verwendung: make -C k-playbook install
   ohne make: k-playbook/bin/install

Aufgerufen wird beides aus dem Hauptverzeichnis des Projekts; ein Zielprojekt
hat kein eigenes install-Target.

Lädt das Release-Binary, das VERSION in diesem Clone nennt, prüft es gegen
SHA256SUMS und installiert es nach ~/.local/bin/k-playbook.
EOF
}

case "${1:-}" in
  "") ;;
  help|-h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

script_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(dirname "${script_dir}")"

version_file="${root_dir}/VERSION"
sums_file="${root_dir}/SHA256SUMS"
[[ -f "${version_file}" ]] || fail "VERSION fehlt: ${version_file}"
[[ -f "${sums_file}" ]] || fail "SHA256SUMS fehlt: ${sums_file}"

version="$(tr -d '[:space:]' < "${version_file}")"
[[ -n "${version}" ]] || fail "VERSION ist leer: ${version_file}"

case "$(uname -s)" in
  Linux) os="linux" ;;
  Darwin) os="darwin" ;;
  *) fail "Nicht unterstütztes Betriebssystem: $(uname -s)" ;;
esac

case "$(uname -m)" in
  x86_64|amd64) arch="amd64" ;;
  arm64|aarch64) arch="arm64" ;;
  *) fail "Nicht unterstützte Architektur: $(uname -m)" ;;
esac

binary="k-playbook-${os}-${arch}"
expected="$(awk -v name="${binary}" '$2 == name || $2 == "*" name { print $1; exit }' "${sums_file}")"
[[ -n "${expected}" ]] || fail "Keine Prüfsumme für ${binary} in ${sums_file}"

if command -v sha256sum >/dev/null 2>&1; then
  sha256_of() { sha256sum "$1" | awk '{ print $1 }'; }
elif command -v shasum >/dev/null 2>&1; then
  sha256_of() { shasum -a 256 "$1" | awk '{ print $1 }'; }
else
  fail "Weder sha256sum noch shasum verfügbar; Download kann nicht geprüft werden."
fi

if command -v curl >/dev/null 2>&1; then
  download() { curl -fL --retry 2 --connect-timeout 15 --output "$1" "$2"; }
elif command -v wget >/dev/null 2>&1; then
  download() { wget --output-document="$1" "$2"; }
else
  fail "Weder curl noch wget verfügbar; Release-Binary kann nicht geladen werden."
fi

# physical_path löst Symlinks im Pfad auf, soweit das Verzeichnis existiert.
# Auf macOS ist $HOME über /System/Volumes/Data verlinkt; ohne die Auflösung
# hielte der PATH-Vergleich zwei Schreibweisen desselben Verzeichnisses
# auseinander.
physical_path() {
  local dir="$1"
  [[ -d "${dir}" ]] || { printf '%s' "${dir}"; return 0; }
  (cd -P "${dir}" 2>/dev/null && pwd) || printf '%s' "${dir}"
}

# path_contains meldet, ob ein Verzeichnis im PATH steht — verglichen wird die
# Schreibweise selbst und, wo auflösbar, der physische Pfad.
path_contains() {
  local wanted="$1" wanted_physical entry
  local -a entries=()
  wanted_physical="$(physical_path "${wanted}")"
  # Zerlegt wird über `read -a` und nicht über ein ungequotetes ${PATH}: dort
  # greift neben dem Wortsplitting auch die Pfadnamen-Expansion. Ein Eintrag
  # mit *, ? oder [ würde dann durch passende Dateinamen ersetzt — und ein
  # Verzeichnis, das tatsächlich im PATH steht, gälte als nicht gefunden.
  IFS=":" read -r -a entries <<<"${PATH}"
  [[ ${#entries[@]} -gt 0 ]] || return 1
  for entry in "${entries[@]}"; do
    [[ -n "${entry}" ]] || continue
    if [[ "${entry}" == "${wanted}" || "${entry}" == "${wanted_physical}" ]]; then
      return 0
    fi
    if [[ -d "${entry}" && "$(physical_path "${entry}")" == "${wanted_physical}" ]]; then
      return 0
    fi
  done
  return 1
}

# require_target_dir_in_path bricht ab, wenn das Zielverzeichnis nicht im PATH
# liegt.
#
# Das ist kein Hinweis am Rand: nach dem Ausstieg aus dem projektlokalen
# Wrapper ist `k-playbook` der einzige Aufruf. Ein installiertes, aber nicht
# auffindbares Binary wäre ein stiller Totalausfall — Commands, Instruktionen
# und die MCP-Registrierung liefen alle ins Leere, ohne dass der Bootstrap je
# etwas gemeldet hätte.
# Geprüft wird erst, nachdem das Zielverzeichnis angelegt ist: sonst bewertet
# die Prüfung eine Lage, die der Bootstrap selbst gerade aufgelöst hat. Welcher
# Hinweis richtig ist, hängt genau daran — deshalb der Blick auf
# target_dir_created.
require_target_dir_in_path() {
  if path_contains "${target_dir}"; then
    return 0
  fi

  local -a hint
  if [[ -n "${target_dir_created}" ]]; then
    # Der Debian-Fall: dort steht die Aufnahme von ~/.local/bin bereits in
    # ~/.profile, aber unter `if [ -d "$HOME/.local/bin" ]`. Beim allerersten
    # Bootstrap auf einem frischen Host oder in einem DevContainer gab es das
    # Verzeichnis beim Anmelden noch nicht — das Profil ist also richtig und
    # greift ab der nächsten Anmeldung von selbst.
    hint=(
      "Das Verzeichnis gab es bis eben nicht; angelegt ist es jetzt. Debian und"
      "Ubuntu nehmen ~/.local/bin in ~/.profile nur auf, wenn es beim Anmelden"
      "bereits existiert — dort ist nichts zu ändern. Melde dich neu an oder"
      "lade dein Profil neu (bash: . ~/.profile) und rufe den Bootstrap erneut"
      "auf:"
      ""
      "  make -C k-playbook install"
      ""
      "Bleibt das Verzeichnis auch danach draußen, kennt dein Profil den Eintrag"
      "nicht. Dann aufnehmen — ~/.zprofile bei zsh, ~/.bashrc bei bash:"
      ""
      '  export PATH="$HOME/.local/bin:$PATH"'
    )
  else
    hint=(
      "Ins Shell-Profil aufnehmen — ~/.zprofile bei zsh, ~/.bashrc bei bash:"
      ""
      '  export PATH="$HOME/.local/bin:$PATH"'
      ""
      "Danach eine neue Shell öffnen und den Bootstrap erneut aufrufen."
    )
  fi

  fail "${target_dir} liegt nicht im PATH." \
    "" \
    "k-playbook wird ausschließlich unter seinem Namen aufgerufen; ohne diesen" \
    "Eintrag wäre es zwar installiert, aber nirgends auffindbar. Deshalb bricht" \
    "der Bootstrap hier ab, statt einen stillen Erfolg zu melden." \
    "" \
    "${hint[@]}"
}

# foreign_platform_kind meldet, welcher fremden Plattform ein bereits
# vorhandenes Binary angehört: "macOS", "Linux" oder leer.
#
# Erkannt wird an den Magic-Bytes, nicht über `file` — das fehlt in schlanken
# Containern. Gemeldet wird nur, was sich positiv als Format der jeweils
# anderen Plattform lesen lässt; alles andere (Skript, Symlink, Fragment)
# bleibt stumm.
foreign_platform_kind() {
  local path="$1" magic
  [[ -f "${path}" && ! -L "${path}" ]] || return 0
  magic="$(head -c 4 "${path}" 2>/dev/null | od -An -v -tx1 | tr -d ' \n')"
  case "${os}:${magic}" in
    # ELF auf einem Darwin-Host.
    darwin:7f454c46) printf 'Linux' ;;
    # Mach-O (32/64 Bit, beide Endianness) und Universal Binaries auf Linux.
    linux:cffaedfe|linux:cefaedfe|linux:feedface|linux:feedfacf|linux:cafebabe|linux:bebafeca) printf 'macOS' ;;
    *) : ;;
  esac
}

target_dir="${HOME:?HOME ist nicht gesetzt}/.local/bin"
target="${target_dir}/k-playbook"
url="${release_base_url}/${version}/${binary}"

# Das Zielverzeichnis entsteht **vor** der PATH-Prüfung. Debians und Ubuntus
# ~/.profile nimmt ~/.local/bin nur auf, `if [ -d "$HOME/.local/bin" ]`; auf
# einem frischen Host oder in einem DevContainer gibt es das Verzeichnis beim
# allerersten Bootstrap noch nicht. Andersherum bewertete die Prüfung eine Lage,
# die eine Zeile später ohnehin aufgelöst war, und verwies auf ein Profil, das
# längst richtig ist.
target_dir_created=""
[[ -d "${target_dir}" ]] || target_dir_created="ja"
mkdir -p "${target_dir}"

# Beide Prüfungen laufen **vor** dem Download: sie brauchen kein Release-Asset,
# und ein Abbruch soll nichts geladen und nichts ersetzt haben. Das angelegte
# Zielverzeichnis bleibt dabei stehen — leer und genau dort, wo das Profil bei
# der nächsten Anmeldung nachsieht.
require_target_dir_in_path
foreign="$(foreign_platform_kind "${target}")"

temporary="$(mktemp "${target_dir}/.k-playbook.XXXXXX")"
trap 'rm -f "${temporary}"' EXIT

printf 'Lade %s ...\n' "${url}"
download "${temporary}" "${url}"

actual="$(sha256_of "${temporary}")"
if [[ "${actual}" != "${expected}" ]]; then
  fail "Prüfsumme weicht ab für ${binary}
  erwartet: ${expected}
  erhalten: ${actual}"
fi

# Ein alter Symlink muss selbst ersetzt werden, nicht sein bisheriges Ziel.
if [[ -L "${target}" ]]; then
  rm -f "${target}"
fi
chmod 0755 "${temporary}"
mv -f "${temporary}" "${target}"
temporary=""

# Der alte Wrapper legte seine Spiegelung und Downloads außerhalb von bin/ ab.
# Security-Tool-venvs liegen ebenfalls unter ~/.local/share/k-playbook und
# bleiben deshalb ausdrücklich außerhalb dieser Bereinigung.
rm -rf "${HOME}/.local/share/k-playbook/installation" "${HOME}/.cache/k-playbook"

printf 'Installiert: %s (%s)\n' "${target}" "${version}"

# Host und DevContainer, die sich dasselbe $HOME teilen, überschreiben einander
# an dieser Datei. Das ist kein Fehler dieses Laufs — hier steht jetzt das
# richtige Binary —, aber die andere Umgebung ist damit lahmgelegt und muss
# denselben Bootstrap noch einmal ausführen. Deshalb wird das Ersetzen genannt
# und nicht stillschweigend getan.
#
# Die Grenze dieser Erkennung: sie sitzt allein hier. Ruft jemand
# ~/.local/bin/k-playbook direkt auf, während dort ein plattformfremdes Binary
# liegt, fängt das niemand ab — der Aufruf endet mit der Meldung der Shell
# ("cannot execute binary file"). Die make-Targets tragen die Erkennung
# ebenfalls nicht: `make dev-install` und `make gui` bauen vorher unbedingt für
# die eigene Plattform, dort kann nie ein fremdes Binary stehen.
if [[ -n "${foreign}" ]]; then
  printf '\n'
  printf 'Ersetzt wurde ein %s-Binary — offenbar teilen sich Host und Container\n' "${foreign}"
  printf 'dasselbe HOME (%s).\n' "${HOME}"
  printf 'In der anderen Umgebung ist k-playbook damit bis auf Weiteres tot; dort\n'
  printf 'den Bootstrap erneut ausführen:\n\n'
  printf '  make -C k-playbook install\n'
  printf '  oder ohne make: k-playbook/bin/install\n'
fi
