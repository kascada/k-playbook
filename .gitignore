# Private/local material
priv/
.priv/
/installer/bin/

# Dieses Repo ist zugleich sein eigenes Zielprojekt: die Installation liegt
# unter k-playbook/, die Konfiguration daneben. Beides entsteht lokal beim
# ersten Start und gehört nicht ins Quell-Repo. In einem echten Zielprojekt
# gilt das Gegenteil: dort werden K-PLAYBOOK.yaml und k-playbook-local/
# committet.
/K-PLAYBOOK.yaml
/k-playbook/
/k-playbook-local/

# Registrierung des MCP-Servers. Ihr Kommando ist relativ und hängt damit am
# Arbeitsverzeichnis des Clients — was hier passt, passt anderswo nicht. Dazu
# kommt: /k-playbook/ ist hier selbst ignoriert, der eingetragene Wrapper
# entsteht also erst lokal. Ein eingecheckter Eintrag zeigte nach einem frischen
# Clone ins Leere. Wer die Registrierung braucht, legt sie in der Oberfläche an;
# docs/mcp.md nennt den Weg. In einem echten Zielprojekt gehören beide Dateien
# dagegen ins Repository.
/.mcp.json
/.cursor/mcp.json

# Secrets and local environment
.env
.env.*
!.env.example
!.env.*.example

# Python/runtime artifacts
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/

# Local caches and logs
.cache/
*.log
*.tmp

# Go build artifacts
/installer/k-playbook-installer

# Die Plattform-Binaries sind Release-Assets und werden nicht mehr versioniert:
# 57 MB je Build-Satz, und jedes Update zog alle vier. Der Wrapper baut sie
# lokal (make dist-host) oder lädt genau das eine, das er braucht, in den Cache.
/dist/

# Cache-Ort für Container-Projekte, die K_PLAYBOOK_CACHE auf den Workspace
# zeigen lassen, damit er den Rebuild überlebt.
k-playbook-local/.cache/

# Editor/OS noise
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Local security-tool downloads and outputs
codeql-cli/
codeql-*.zip
databases/
results/
