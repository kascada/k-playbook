# Private/local material
priv/
.priv/
/installer/bin/

# Dieses Repo ist zugleich sein eigenes Zielprojekt: die Installation liegt
# unter k-playbook/, die Konfiguration daneben. Beides entsteht lokal beim
# ersten Start und gehört nicht ins Quell-Repo. In einem echten Zielprojekt
# gilt das Gegenteil: dort werden K-PLAYBOOK.yaml und k-playbook-local/
# committet.
/K-PLAYBOOK.yaml
/k-playbook/
/k-playbook-local/

# Registrierung des MCP-Servers für den Handtest. Ihr Kommando ist relativ und
# hängt damit am Arbeitsverzeichnis des Clients — was hier passt, passt anderswo
# nicht. Wer sie braucht, legt sie selbst an; docs/installation.md nennt den Weg.
/.mcp.json

# Secrets and local environment
.env
.env.*
!.env.example
!.env.*.example

# Python/runtime artifacts
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/

# Local caches and logs
.cache/
*.log
*.tmp

# Go build artifacts
/installer/k-playbook-installer

# Editor/OS noise
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Local security-tool downloads and outputs
codeql-cli/
codeql-*.zip
databases/
results/
